# --- База данных (Aiven или Neon, PostgreSQL) ---
DATABASE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: на Render берётся из RENDER_EXTERNAL_URL автоматически
WEBHOOK_URL=
# Необязательно: если пусто, генерируется при старте
TELEGRAM_WEBHOOK_SECRET=

# --- Админ ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Необязательно: пароль в открытом виде вместо хеша (только для локального запуска)
ADMIN_PASSWORD=

# --- Сессии и окружение ---
SESSION_SECRET=
# На Render не задавайте вручную: render.yaml выставляет production
NODE_ENV=development
# Render задаёт PORT сам, локально можно не указывать
PORT=3000
# Часовой пояс для дат в интерфейсе и в Telegram
TZ=Europe/Moscow
