<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Admin Menu</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-mark">AM</span>
        <span>Admin Menu</span>
      </a>
      <nav class="nav">
        <a class="nav-link <%= path === '/' ? 'is-active' : '' %>" href="/">Тесты</a>
        <% if (isAdmin) { %>
          <a class="nav-link <%= path.startsWith('/admin/tests') ? 'is-active' : '' %>" href="/admin/tests">Админка</a>
          <a class="nav-link <%= path.startsWith('/admin/results') ? 'is-active' : '' %>" href="/admin/results">Результаты</a>
          <form method="post" action="/admin/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="nav-link nav-button">Выйти</button>
          </form>
        <% } else { %>
          <a class="nav-link nav-login" href="/admin/login">Вход для админа</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container main">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
    <% } %>
