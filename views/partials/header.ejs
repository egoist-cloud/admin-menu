<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Admin Menu</title>
  <meta name="theme-color" content="#1b1c1f">
  <link rel="icon" href="/cs2red-logo.png" type="image/png">
  <link rel="stylesheet" href="/styles.css?v=20261112-red-icon">
  <script src="/recover.js" defer></script>
</head>
<body>
  <%
    const userInitial = currentUser ? (currentUser.displayName || '?').trim().charAt(0).toUpperCase() : '?';
    const topbarName = currentUser ? currentUser.displayName : (isAdmin ? 'owner' : 'гость');
    const topbarHref = currentUser ? '/confusa' : (isAdmin ? '/admin/tests' : '/confusa');
  %>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/cs2red-logo.png" width="38" height="38" alt="">
        <span class="brand-text">КС2РЕД</span>
      </a>

      <div class="side-label">Меню</div>
      <nav class="side-nav">
        <a class="side-link <%= path === '/' ? 'is-active' : '' %>" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
          <span>Тесты</span>
        </a>
        <a class="side-link <%= path.startsWith('/confusa') || path.startsWith('/auth/steam') ? 'is-active' : '' %>" href="/confusa">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Confusa</span>
        </a>
        <% if (isAdmin) { %>
          <a class="side-link <%= path.startsWith('/admin/tests') ? 'is-active' : '' %>" href="/admin/tests">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Админка</span>
          </a>
          <a class="side-link <%= path.startsWith('/admin/results') ? 'is-active' : '' %>" href="/admin/results">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
            <span>Результаты</span>
          </a>
          <a class="side-link <%= path.startsWith('/admin/telegram') ? 'is-active' : '' %>" href="/admin/telegram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-9 18-2.5-7.5L2 11z"/></svg>
            <span>Telegram</span>
          </a>
        <% } %>
      </nav>

      <div class="sidebar-foot">
        <% if (currentUser) { %>
          <div class="side-user">
            <span class="avatar"><%= userInitial %></span>
            <span class="side-user-text">
              <strong><%= currentUser.displayName %></strong>
              <small><%= roleLabel(currentRole) %></small>
            </span>
          </div>
          <form method="post" action="/admin/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="side-link side-logout">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
              <span>Выйти</span>
            </button>
          </form>
        <% } else if (isAdmin) { %>
          <div class="side-user">
            <span class="avatar">A</span>
            <span class="side-user-text"><strong>Администратор</strong><small>владелец · панель управления</small></span>
          </div>
          <form method="post" action="/admin/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="side-link side-logout">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
              <span>Выйти</span>
            </button>
          </form>
        <% } else { %>
          <a class="side-link" href="/confusa">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Steam-вход</span>
          </a>
          <a class="side-link" href="/admin/login">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
            <span>Вход для админа</span>
          </a>
        <% } %>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <div class="topbar-inner">
          <div class="topbar-title"><span class="status-dot"></span><%= title %></div>
          <div class="topbar-user">
            <span class="server-pill">ADMIN MENU</span>
            <a class="user-chip" href="<%= topbarHref %>">
              <span class="avatar"><%= currentUser ? userInitial : (isAdmin ? 'A' : 'Г') %></span>
              <span><%= topbarName %></span>
            </a>
          </div>
        </div>
      </header>

      <main class="main">
        <div class="container">
          <% if (flash) { %>
            <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
          <% } %>
