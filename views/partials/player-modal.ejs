<div class="player-modal" id="player-modal" hidden>
  <div class="player-modal-backdrop" data-close-player></div>
  <div class="player-modal-card" role="dialog" aria-modal="true" aria-labelledby="player-modal-title">
    <button class="player-modal-close" type="button" data-close-player aria-label="Закрыть">×</button>

    <div class="player-modal-head">
      <span class="player-avatar" id="player-modal-avatar">?</span>
      <div>
        <h2 id="player-modal-title">История игрока</h2>
        <p class="muted small" id="player-modal-subtitle">История прохождений</p>
      </div>
    </div>

    <div class="player-stats" id="player-modal-stats"></div>
    <div class="player-history" id="player-modal-list"></div>
  </div>
</div>

<script src="/players.js" defer></script>
